<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement class="bvp-root">
        <engine:VisualElement name="HeaderCard" class="bvp-card bvp-header-card">
            <engine:Label text="Basis Media Diagnostics" name="HeaderTitle" selectable="false" class="bvp-header-title"/>
            <engine:Label text="Per-frame CSV logger (sandboxed to persistentDataPath)" name="HeaderSubtitle" selectable="false" class="bvp-header-subtitle"/>
        </engine:VisualElement>

        <engine:Foldout text="Logging" name="LoggingFoldout" value="true" class="bvp-foldout">
            <engine:Toggle label="Auto Start" name="AutoStartField" tooltip="Begin writing CSV on OnEnable."/>
            <engine:FloatField label="Snapshots Per Second" name="SnapshotsPerSecondField" tooltip="50 Hz is dense enough to see audio-callback chunking."/>
            <engine:IntegerField label="Flush Every N Snapshots" name="FlushEveryField"/>
            <engine:Toggle label="Append Between Sessions" name="AppendField" tooltip="If OFF, the file is truncated on each StartLogging()."/>
            <engine:TextField label="Log Path Override" name="LogPathOverrideField" tooltip="Sandboxed to persistentDataPath. Empty = default BasisMediaPlayerDiag.csv."/>
        </engine:Foldout>

        <engine:Foldout text="Live Status" name="StatusFoldout" value="true" class="bvp-foldout">
            <engine:VisualElement class="bvp-status-grid">
                <engine:VisualElement class="bvp-status-row"><engine:Label text="Is Logging" class="bvp-status-label"/><engine:Label text="—" name="StatusIsLogging" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                <engine:VisualElement class="bvp-status-row"><engine:Label text="Snapshots Written" class="bvp-status-label"/><engine:Label text="—" name="StatusSnapshots" class="bvp-status-value"/></engine:VisualElement>
            </engine:VisualElement>
            <engine:Label text="Resolved Path:" class="bvp-section-title" style="margin-top: 6px;"/>
            <engine:Label text="—" name="StatusResolvedPath" class="bvp-counters"/>
            <engine:Label text="Enter Play Mode to start/stop logging and see live counters." name="StatusEditModeHint" class="bvp-help-info"/>
        </engine:Foldout>

        <engine:VisualElement name="ActionsCard" class="bvp-card bvp-actions-card">
            <engine:Button text="Start" name="ActStartButton" class="bvp-primary-button"/>
            <engine:Button text="Stop" name="ActStopButton" class="bvp-secondary-button"/>
            <engine:Button text="Flush" name="ActFlushButton" class="bvp-secondary-button"/>
            <engine:Button text="Reveal" name="ActRevealButton" class="bvp-secondary-button"/>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
