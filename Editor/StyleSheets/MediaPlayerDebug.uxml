<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement class="bvp-root">
        <engine:VisualElement name="HeaderCard" class="bvp-card bvp-header-card">
            <engine:Label text="Media Player Debug" name="HeaderTitle" selectable="false" class="bvp-header-title"/>
            <engine:Label text="Source → Packet → Decode → Queue → Render / Audio Out" name="HeaderSubtitle" selectable="false" class="bvp-header-subtitle"/>
        </engine:VisualElement>

        <engine:VisualElement name="TargetCard" class="bvp-card">
            <editor:ObjectField name="TargetPlayer" label="Player" allow-scene-objects="true" type="BasisMediaPlayer, BasisMediaPlayer"/>
            <engine:Label text="Enter Play Mode for live counters." name="EditModeHint" class="bvp-help-info"/>
            <engine:VisualElement name="DiagnosticsRow" class="bvp-bar-row" style="flex-wrap: wrap;">
                <engine:Label text="Diagnostics CSV" class="bvp-bar-label"/>
                <engine:Button text="Attach Logger" name="DiagAttachButton" class="bvp-secondary-button"/>
                <engine:Button text="Start" name="DiagStartButton" class="bvp-secondary-button"/>
                <engine:Button text="Stop" name="DiagStopButton" class="bvp-secondary-button"/>
                <engine:Button text="Flush" name="DiagFlushButton" class="bvp-secondary-button"/>
                <engine:Button text="Reveal" name="DiagRevealButton" class="bvp-secondary-button"/>
            </engine:VisualElement>
            <engine:Label text="Path: (none)" name="DiagPathLabel" class="bvp-mini-note"/>
            <engine:Label text="Snapshots: 0" name="DiagSnapshotsLabel" class="bvp-mini-note"/>
        </engine:VisualElement>

        <engine:ScrollView name="MainScroll" class="bvp-scroll">
            <engine:VisualElement name="MissingTargetBanner" class="bvp-help-info">
                <engine:Label text="No BasisMediaPlayer assigned and none found in the scene. Assign one above or enter Play Mode with a scene that has one." class="bvp-help-info"/>
            </engine:VisualElement>

            <engine:Foldout text="1. Player" name="PlayerFoldout" value="true" class="bvp-foldout">
                <engine:VisualElement name="PlayerSection" class="bvp-status-grid">
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Playing" class="bvp-status-label"/><engine:Label name="P_Playing" text="—" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Paused" class="bvp-status-label"/><engine:Label name="P_Paused" text="—" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Frames Presented" class="bvp-status-label"/><engine:Label name="P_FramesPresented" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Queue Length Max" class="bvp-status-label"/><engine:Label name="P_MaxQueue" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Late-Frame Skip" class="bvp-status-label"/><engine:Label name="P_LateSkip" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Presentation Offset" class="bvp-status-label"/><engine:Label name="P_PresOffset" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Overflow Policy" class="bvp-status-label"/><engine:Label name="P_OverflowPolicy" text="—" class="bvp-status-value"/></engine:VisualElement>
                </engine:VisualElement>
                <engine:Label name="P_Help" text="" class="bvp-help-warn" style="display: none;"/>
            </engine:Foldout>

            <engine:Foldout text="2. Source / Transport" name="SourceFoldout" value="true" class="bvp-foldout">
                <engine:VisualElement name="SourceSection" class="bvp-status-grid">
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Backend" class="bvp-status-label"/><engine:Label name="S_Backend" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="URL / Type" class="bvp-status-label"/><engine:Label name="S_UrlOrType" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Running" class="bvp-status-label"/><engine:Label name="S_Running" text="—" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="State" class="bvp-status-label"/><engine:Label name="S_State" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Video Size" class="bvp-status-label"/><engine:Label name="S_VideoSize" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Position" class="bvp-status-label"/><engine:Label name="S_Position" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Output Texture" class="bvp-status-label"/><engine:Label name="S_OutputTex" text="—" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                </engine:VisualElement>
                <engine:Label name="S_Help" text="" class="bvp-help-warn" style="display: none;"/>
            </engine:Foldout>

            <engine:Foldout text="3. Video Decode" name="VideoDecodeFoldout" value="true" class="bvp-foldout">
                <engine:VisualElement name="VideoDecodeSection" class="bvp-status-grid">
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Decoder" class="bvp-status-label"/><engine:Label name="VD_Decoder" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Decoded Size" class="bvp-status-label"/><engine:Label name="VD_DecodedSize" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Last PTS" class="bvp-status-label"/><engine:Label name="VD_LastPts" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Output Texture" class="bvp-status-label"/><engine:Label name="VD_OutputTex" text="—" class="bvp-status-value"/></engine:VisualElement>
                </engine:VisualElement>
                <engine:Label name="VD_Help" text="" class="bvp-help-warn" style="display: none;"/>
            </engine:Foldout>

            <engine:Foldout text="4. Video Queue" name="VideoQueueFoldout" value="true" class="bvp-foldout">
                <engine:VisualElement name="VideoQueueSection" class="bvp-status-grid">
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Backend" class="bvp-status-label"/><engine:Label name="VQ_Backend" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="State" class="bvp-status-label"/><engine:Label name="VQ_State" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Time to First Frame" class="bvp-status-label"/><engine:Label name="VQ_TTFF" text="—" class="bvp-status-value"/></engine:VisualElement>
                </engine:VisualElement>

                <engine:Label text="Framerate" class="bvp-section-title" style="margin-top: 6px;"/>
                <engine:VisualElement class="bvp-status-grid">
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Decoded" class="bvp-status-label"/><engine:Label name="VQ_FpsDecoded" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Displayed" class="bvp-status-label"/><engine:Label name="VQ_FpsDisplayed" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Render Calls" class="bvp-status-label"/><engine:Label name="VQ_FpsRender" text="—" class="bvp-status-value"/></engine:VisualElement>
                </engine:VisualElement>

                <engine:Label text="Playback Buffer" class="bvp-section-title" style="margin-top: 6px;"/>
                <engine:VisualElement name="VQ_BufferRow" class="bvp-bar-row">
                    <engine:Label name="VQ_BufferLabel" text="—" class="bvp-bar-label"/>
                    <engine:VisualElement class="bvp-bar-track">
                        <engine:VisualElement name="VQ_BufferFill" class="bvp-bar-fill"/>
                    </engine:VisualElement>
                    <engine:Label name="VQ_BufferValue" text="—" class="bvp-bar-value"/>
                </engine:VisualElement>

                <engine:Label text="Queue Depth (CPU path)" class="bvp-section-title" style="margin-top: 6px;"/>
                <engine:VisualElement name="VQ_DepthRow" class="bvp-bar-row">
                    <engine:Label text="Queued" class="bvp-bar-label"/>
                    <engine:VisualElement class="bvp-bar-track">
                        <engine:VisualElement name="VQ_DepthFill" class="bvp-bar-fill"/>
                    </engine:VisualElement>
                    <engine:Label name="VQ_DepthValue" text="—" class="bvp-bar-value"/>
                </engine:VisualElement>

                <engine:Label text="Queue Timing (CPU path)" class="bvp-section-title" style="margin-top: 6px;"/>
                <engine:VisualElement class="bvp-status-grid">
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Clock Now" class="bvp-status-label"/><engine:Label name="VQ_ClockNow" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Head PTS" class="bvp-status-label"/><engine:Label name="VQ_HeadPts" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Tail PTS" class="bvp-status-label"/><engine:Label name="VQ_TailPts" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Queue Span" class="bvp-status-label"/><engine:Label name="VQ_QueueSpan" text="—" class="bvp-status-value"/></engine:VisualElement>
                </engine:VisualElement>

                <engine:Label text="Drop Categories" class="bvp-section-title" style="margin-top: 6px;"/>
                <engine:VisualElement class="bvp-status-grid">
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Overflow (queue full)" class="bvp-status-label"/><engine:Label name="VQ_DropOverflow" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Late-skip" class="bvp-status-label"/><engine:Label name="VQ_DropLate" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Format-error" class="bvp-status-label"/><engine:Label name="VQ_DropFormat" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Catch-up coalesce" class="bvp-status-label"/><engine:Label name="VQ_DropCatchup" text="—" class="bvp-status-value"/></engine:VisualElement>
                </engine:VisualElement>

                <engine:Label text="Native Counters" class="bvp-section-title" style="margin-top: 6px;"/>
                <engine:Label name="VQ_NativeCounters" text="(no data — is the plugin built?)" class="bvp-counters"/>
                <engine:Label text="blit=decoded  copy=presented  lag=ms behind live" class="bvp-mini-note"/>

                <engine:Label name="VQ_Help" text="" class="bvp-help-warn" style="display: none; margin-top: 6px;"/>
            </engine:Foldout>

            <engine:Foldout text="5. A/V Sync Clock" name="ClockFoldout" value="true" class="bvp-foldout">
                <engine:VisualElement class="bvp-status-grid">
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Started" class="bvp-status-label"/><engine:Label name="C_Started" text="—" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Current Media Time" class="bvp-status-label"/><engine:Label name="C_CurrentTime" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="External Source Wired" class="bvp-status-label"/><engine:Label name="C_HasExternal" text="—" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="External Has Media Time" class="bvp-status-label"/><engine:Label name="C_ExtHasMedia" text="—" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="External Media Time" class="bvp-status-label"/><engine:Label name="C_ExtTime" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="External Type" class="bvp-status-label"/><engine:Label name="C_ExtType" text="—" class="bvp-status-value"/></engine:VisualElement>
                </engine:VisualElement>
            </engine:Foldout>

            <engine:Foldout text="6. Audio Decode" name="AudioDecodeFoldout" value="true" class="bvp-foldout">
                <engine:VisualElement class="bvp-status-grid">
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Decoder" class="bvp-status-label"/><engine:Label name="AD_Decoder" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Format" class="bvp-status-label"/><engine:Label name="AD_Format" text="—" class="bvp-status-value"/></engine:VisualElement>
                </engine:VisualElement>
            </engine:Foldout>

            <engine:Foldout text="7. Audio Queue" name="AudioQueueFoldout" value="true" class="bvp-foldout">
                <engine:VisualElement class="bvp-status-grid">
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Backend" class="bvp-status-label"/><engine:Label name="AQ_Backend" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Format" class="bvp-status-label"/><engine:Label name="AQ_Format" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Source Playing" class="bvp-status-label"/><engine:Label name="AQ_SourcePlaying" text="—" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="PCM peak / rms" class="bvp-status-label"/><engine:Label name="AQ_PcmLevels" text="—" class="bvp-status-value"/></engine:VisualElement>
                </engine:VisualElement>

                <engine:Label text="Queue Depth" class="bvp-section-title" style="margin-top: 6px;"/>
                <engine:VisualElement class="bvp-bar-row">
                    <engine:Label text="Audio frames" class="bvp-bar-label"/>
                    <engine:VisualElement class="bvp-bar-track">
                        <engine:VisualElement name="AQ_DepthFill" class="bvp-bar-fill bvp-bar-fill-audio"/>
                    </engine:VisualElement>
                    <engine:Label name="AQ_DepthValue" text="—" class="bvp-bar-value"/>
                </engine:VisualElement>

                <engine:VisualElement class="bvp-status-grid">
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Dropped (total)" class="bvp-status-label"/><engine:Label name="AQ_Dropped" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Drop Policy" class="bvp-status-label"/><engine:Label name="AQ_DropPolicy" text="—" class="bvp-status-value"/></engine:VisualElement>
                </engine:VisualElement>

                <engine:Label name="AQ_Help" text="" class="bvp-help-info" style="display: none; margin-top: 6px;"/>
            </engine:Foldout>

            <engine:Foldout text="8. Audio Output" name="AudioOutputFoldout" value="true" class="bvp-foldout">
                <engine:VisualElement class="bvp-status-grid">
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="AudioSource" class="bvp-status-label"/><engine:Label name="AO_SourceName" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Is Playing" class="bvp-status-label"/><engine:Label name="AO_IsPlaying" text="—" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Volume" class="bvp-status-label"/><engine:Label name="AO_Volume" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Spatial Blend" class="bvp-status-label"/><engine:Label name="AO_SpatialBlend" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Mute (sink)" class="bvp-status-label"/><engine:Label name="AO_Mute" text="—" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Gain (sink)" class="bvp-status-label"/><engine:Label name="AO_Gain" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Clip" class="bvp-status-label"/><engine:Label name="AO_Clip" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Format" class="bvp-status-label"/><engine:Label name="AO_Format" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Consumed Samples" class="bvp-status-label"/><engine:Label name="AO_Consumed" text="—" class="bvp-status-value"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Has Media Anchor" class="bvp-status-label"/><engine:Label name="AO_HasAnchor" text="—" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                    <engine:VisualElement class="bvp-status-row"><engine:Label text="Audio Media Time" class="bvp-status-label"/><engine:Label name="AO_MediaTime" text="—" class="bvp-status-value"/></engine:VisualElement>
                </engine:VisualElement>

                <engine:Label name="AO_Help" text="" class="bvp-help-warn" style="display: none; margin-top: 6px;"/>
            </engine:Foldout>
        </engine:ScrollView>
    </engine:VisualElement>
</engine:UXML>
